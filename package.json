{
  "name": "clink",
  "version": "1.0.0",
  "private": true,
  "description": "Clink \u2014 strips tracking junk from links in Chrome, Firefox and Safari.",
  "homepage": "https://github.com/iacompa/Clink#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iacompa/Clink.git"
  },
  "bugs": {
    "url": "https://github.com/iacompa/Clink/issues"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node scripts/build.mjs && node --test --test-concurrency=1 \"test/e2e/*.test.mjs\"",
    "lint:firefox": "node scripts/build.mjs && web-ext lint --source-dir dist/firefox",
    "safari": "node scripts/build.mjs && node scripts/safari.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "assets": "node scripts/build.mjs && node scripts/store-assets.mjs"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "playwright": "^1.65.0",
    "web-ext": "^10.8.0"
  }
}
